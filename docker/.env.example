# Copy this file to .env (same directory) and fill in the values.
#   cp .env.example .env
# .env is gitignored and must never be committed.
#
# The quickest way to produce a correct .env is to run ../setup.sh from the
# repository root, which generates the signing key for you.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Signs the Flask session cookie. Without it the application generates a random
# key at every start, which silently logs everyone out on each restart.
# Generate one with:  openssl rand -base64 48
THEPHISH_SECRET_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL - authentication
# ---------------------------------------------------------------------------

# Public origin of this installation, without a trailing slash. Only needed
# when the panel runs behind a proxy that terminates TLS: the SSO redirect URI
# must match, byte for byte, what is registered in Entra ID, and the process
# itself only sees the internal address.
#   BLUEPHISH_BASE_URL=https://bluephish.acme.com
BLUEPHISH_BASE_URL=

# How long a session survives with no sign of life from its browser tab, in
# seconds (default 300, minimum 60). Closing the tab revokes the session right
# away when the panel is reopened; this is the server-side sweep for the tab
# that was closed and never came back. Browsers throttle background tabs to one
# timer per minute, so values under ~120 log out people who merely switched
# windows.
BLUEPHISH_TAB_GRACE_SECONDS=

# Name the authenticator app shows next to the six-digit code (default
# "bluephish"). Worth setting when the same person has more than one
# installation paired on the same phone — staging and production produce two
# entries that are otherwise indistinguishable. Changing it later does NOT
# break the codes already paired: the name is cosmetic and only reaches the app
# at the moment the QR is scanned.
#   BLUEPHISH_MFA_ISSUER=bluephish (production)
BLUEPHISH_MFA_ISSUER=
