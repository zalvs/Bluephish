{
	"version": 1,
	"disable_existing_loggers": false,
	"formatters": {
		"formatter_console": { 
			"format": "[%(levelname)s]_[%(name)s]: %(message)s"
		}
	},
	"handlers": { 
		"handler_console": { 
			"level": "INFO",
			"formatter": "formatter_console",
			"class": "logging.StreamHandler",
			"stream": "ext://sys.stdout"
		}
	},
	"loggers": { 
		"": {  
			"handlers": ["handler_console"],
			"level": "INFO"
		},
		"list_emails": {
			"handlers": ["handler_console"],
			"level": "DEBUG",
